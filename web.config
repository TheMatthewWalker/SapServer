<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for the OWIN pipeline (Startup.cs). owin:AppStartup
  pins the startup class explicitly rather than relying on OWIN's assembly
  scan for [assembly: OwinStartup] — Startup.cs already declares that
  attribute too, so this is redundant-but-explicit, matching the pattern
  Katana's own docs recommend for a single-startup-class app.
-->
<configuration>
  <appSettings>
    <add key="owin:AutomaticAppStartup" value="true" />
    <add key="owin:AppStartup" value="SapServer.Startup, SapServer" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <!-- runAllManagedModulesForAllRequests is required for OWIN's SystemWeb
         host module to see every request under IIS Integrated Pipeline mode,
         including ones IIS would otherwise treat as static-file requests. -->
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Populated automatically at build/publish time by MSBuild's
           AutoGenerateBindingRedirects (see SapServer.csproj) — this
           project uses PackageReference, not packages.config, so there is
           no NuGet-install-time web.config transform generating these by
           hand. Verify no FileLoadException on first run against real IIS;
           a fresh AutoGenerateBindingRedirects output has not been produced
           in this sandbox (no MSBuild-classic/IIS available here). -->
    </assemblyBinding>
  </runtime>
</configuration>
