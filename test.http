### POST /api/purchasing/create-po  (dry run — echoes the built RFC request, no SAP call)
# BAPI_PO_CREATE1, ported field-for-field from AT_Dashboard.xlsm (module
# BAPI_PO, sub CreateSAPPurchaseOrder). PO creation only — no goods
# receipt/GRNI booking yet (that's the separate, not-yet-built MIGO step).
#
# Example below is one PO with one cost-center-assigned (K) item, matching
# the intended Inbound Log MIGO use case: freight cost -> cost center 2012
# (PTFE Raw Material), GL 602200. AcctAssCat/MaterialGroup/GlAccount/
# CostCenterOrOrder can be left null for a standard stock line instead
# (see the VBA's own "PO" sheet example row: Material 50065, no Acc. Ass).
POST {{baseUrl}}/api/purchasing/create-po?dryRun=true
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Vendor": "78712",
    "Currency": "GBP",
    "DocDate": "21.07.2026",
    "Items": [
        {
            "ShortText": "Freight - Inbound shipment 000123",
            "Quantity": 1,
            "Unit": "EA",
            "NetPrice": 450.00,
            "DeliveryDate": "21.07.2026",
            "AcctAssCat": "K",
            "MaterialGroup": "Road Freight",
            "GlAccount": "602200",
            "CostCenterOrOrder": "2012"
        }
    ]
}
###


### POST /api/purchasing/create-po  (real call — creates the PO in SAP)
POST {{baseUrl}}/api/purchasing/create-po
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Vendor": "78712",
    "Currency": "GBP",
    "DocDate": "21.07.2026",
    "Items": [
        {
            "ShortText": "Freight - Inbound shipment 000123",
            "Quantity": 1,
            "Unit": "EA",
            "NetPrice": 450.00,
            "DeliveryDate": "21.07.2026",
            "AcctAssCat": "K",
            "MaterialGroup": "Road Freight",
            "GlAccount": "602200",
            "CostCenterOrOrder": "2012"
        }
    ]
}
###


### POST /api/purchasing/post-goods-receipt  (dry run — echoes the built BDC table, no SAP call)
# Transaction MB01 via BDC (Z_RFC_CALL_TRANSACTION) — BAPI_GOODSMVT_CREATE
# doesn't work against this SAP system, so this replicates the user's own
# BDC recording exactly. One call per PO item/cost line — LineNumber 1
# posts against EBELP "00010", 2 against "00020", etc. (SAP renumbers PO
# items in 10s regardless of what was sent at creation). If the PO from the
# create-po example above had 2 cost lines, call this twice: LineNumber 1,
# then LineNumber 2 — each is its own material document, reversible on its own.
POST {{baseUrl}}/api/purchasing/post-goods-receipt?dryRun=true
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "PurchaseOrder": "4500434758",
    "LineNumber": 1,
    "Reference": "INB-000014",
    "TrackingNumber": "TBC",
    "AddressCode": "US28",
    "ShipmentCompletionDate": "23.07.2026",
    "PostingDate": "23.07.2026"
}
###


### POST /api/purchasing/post-goods-receipt  (real call — posts the goods receipt in SAP)
# Response is BdcResponse — DocumentNumber holds the material document
# number if SAP's message included the word "document" followed by digits
# (e.g. "Material document 5000012345 posted"). Store it against this cost
# line; it's needed to reverse just this line later.
POST {{baseUrl}}/api/purchasing/post-goods-receipt
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "PurchaseOrder": "4500434758",
    "LineNumber": 1,
    "Reference": "INB-000014",
    "TrackingNumber": "TBC",
    "AddressCode": "US28",
    "ShipmentCompletionDate": "23.07.2026",
    "PostingDate": "23.07.2026"
}
###


### POST /api/purchasing/post-goods-receipt  (second cost line on the same PO)
POST {{baseUrl}}/api/purchasing/post-goods-receipt
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "PurchaseOrder": "4500434758",
    "LineNumber": 2,
    "Reference": "INB-000014",
    "TrackingNumber": "TBC",
    "AddressCode": "US28",
    "ShipmentCompletionDate": "23.07.2026",
    "PostingDate": "23.07.2026"
}
###


### POST /api/purchasing/reverse-goods-receipt  (reverse a single cost line's GR via MBST)
# Reuses the same MBST BDC already built for scrap reversal
# (ProductionHelpers.BuildMbstRequest) — see PurchasingController for why
# it applies unchanged to our cost-center-assigned GR postings too.
POST {{baseUrl}}/api/purchasing/reverse-goods-receipt
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "MaterialDocument": "5005241047"
}
###


### POST /api/purchasing/create-po-and-receipt  (elevated flow — logon as the
### calling user's own SAP credentials, create PO, commit, one GR per item,
### logoff. Uses one of the pool's elevated worker slots, not the shared
### service account — see task #415 / SapConnectionPool.AcquireElevatedWorkerAsync.)
POST {{baseUrl}}/api/purchasing/create-po-and-receipt
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "SapUsername": "MAWANOGB",
    "SapPassword": "****",
    "Vendor": "0000078712",
    "Currency": "GBP",
    "Items": [
        {
            "ShortText": "Inbound Freight",
            "Quantity": 1,
            "Unit": "EA",
            "NetPrice": 450.00,
            "DeliveryDate": "23.07.2026",
            "AcctAssCat": "K",
            "MaterialGroup": "ITLG01A",
            "GlAccount": "0000602200",
            "CostCenterOrOrder": "2012",
            "Reference": "INB-000014",
            "TrackingNumber": "TRK123456",
            "AddressCode": "US28",
            "ShipmentCompletionDate": "22.07.2026",
            "PostingDate": "23.07.2026"
        }
    ]
}
###


### POST /api/warehouse/stock-adjustment  (dry run — echoes the built RFC request, no SAP call)
# BAPI_GOODSMVT_CREATE, movement type 711 (stock increase). See
# StockAdjustmentModels.cs / StockAdjustmentHelper.cs for the full caveat:
# GoodsReceiptHelper already found this same BAPI doesn't work against this
# SAP system for a different movement (101, GR-for-PO), and had to fall back
# to a BDC of MB01 instead. This uses a different GM_CODE branch ("06" —
# goods movements without reference, the path 711/712 normally go through
# via MB1C) — genuinely untested here rather than known-broken, hence
# testing it via this file before wiring it into Node, exactly as asked.
#
# Replace Material/StorageLocation with real values from your own system
# before running the real-call examples below.
POST {{baseUrl}}/api/warehouse/stock-adjustment?dryRun=true
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Material": "50065",
    "StorageLocation": "0001",
    "MovementType": "711",
    "Quantity": 10,
    "Unit": "KG",
    "Reference": "STOCKADJ-TEST-01"
}
###


### POST /api/warehouse/stock-adjustment  (real call, TESTRUN — SAP simulates the
### posting and returns what it would have done, without creating a material
### document. Good first real-connectivity check: if this comes back with a
### sensible message instead of a generic RFC failure, the BAPI is at least
### reachable and validating input on this system.)
POST {{baseUrl}}/api/warehouse/stock-adjustment
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Material": "50065",
    "StorageLocation": "0001",
    "MovementType": "711",
    "Quantity": 10,
    "Unit": "KG",
    "Reference": "STOCKADJ-TEST-01",
    "TestRun": true
}
###


### POST /api/warehouse/stock-adjustment  (real call — posts a 711 stock increase)
POST {{baseUrl}}/api/warehouse/stock-adjustment
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Material": "50065",
    "StorageLocation": "0001",
    "Batch": "",
    "MovementType": "711",
    "Quantity": 10,
    "Unit": "KG",
    "Reference": "STOCKADJ-TEST-01"
}
###


### POST /api/warehouse/stock-adjustment  (real call — posts a 712 stock decrease,
### to correct the 711 test above back out again once you've confirmed it worked)
POST {{baseUrl}}/api/warehouse/stock-adjustment
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Material": "50065",
    "StorageLocation": "0001",
    "Batch": "",
    "MovementType": "712",
    "Quantity": 10,
    "Unit": "KG",
    "Reference": "STOCKADJ-TEST-01-REV"
}
