### POST /api/purchasing/reverse-goods-receipt  (reverse a single cost line's GR via MBST)
# Reuses the same MBST BDC already built for scrap reversal
# (ProductionHelpers.BuildMbstRequest) — see PurchasingController for why
# it applies unchanged to our cost-center-assigned GR postings too.
POST {{baseUrl}}/api/purchasing/reverse-goods-receipt
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "MaterialDocument": "5005241047"
}
###


### POST /api/purchasing/create-po-and-receipt  (elevated flow — logon as the
### calling user's own SAP credentials, create PO, commit, one GR per item,
### logoff. Uses one of the pool's elevated worker slots, not the shared
### service account — see task #415 / SapConnectionPool.AcquireElevatedWorkerAsync.)
POST {{baseUrl}}/api/purchasing/create-po-and-receipt
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "SapUsername": "MAWANOGB",
    "SapPassword": "****",
    "Vendor": "0000078712",
    "Currency": "GBP",
    "Items": [
        {
            "ShortText": "Inbound Freight",
            "Quantity": 1,
            "Unit": "EA",
            "NetPrice": 450.00,
            "DeliveryDate": "23.07.2026",
            "AcctAssCat": "K",
            "MaterialGroup": "ITLG01A",
            "GlAccount": "0000602200",
            "CostCenterOrOrder": "2012",
            "Reference": "INB-000014",
            "TrackingNumber": "TRK123456",
            "AddressCode": "US28",
            "ShipmentCompletionDate": "22.07.2026",
            "PostingDate": "23.07.2026"
        }
    ]
}
###


### POST /api/purchasing/create-po-elevated  (PO-only counterpart to
### create-po-and-receipt, for the MRP "Create PO in SAP" flow — no goods
### receipt. NetPrice is deliberately OMITTED on this item to test whether
### SAP fills it in itself from the ME12 purchasing info record/condition
### records during BAPI_PO_CREATE1, per the user — swap in a real vendor
### number + material that actually has a purchasing info record/condition
### set up before running this for real. If the returned PO shows a price of
### 0 instead, the condition determination isn't kicking in and NetPrice
### will need to be supplied explicitly from Node after all.)
POST {{baseUrl}}/api/purchasing/create-po-elevated
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "SapUsername": "MAWANOGB",
    "SapPassword": "****",
    "Vendor": "0000078712",
    "Currency": "GBP",
    "Items": [
        {
            "Material": "000000000000123456",
            "ShortText": "MRP replenishment order",
            "Quantity": 500,
            "Unit": "KG",
            "DeliveryDate": "10.08.2026"
        }
    ]
}
###


### POST /api/warehouse/stock-adjustment  (real call, TESTRUN — SAP simulates the
### posting and returns what it would have done, without creating a material
### document. Good first real-connectivity check: if this comes back with a
### sensible message instead of a generic RFC failure, the BAPI is at least
### reachable and validating input on this system.)
POST {{baseUrl}}/api/warehouse/stock-adjustment
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "Material": "B6040/S",
    "Batch": "0035108565",
    "StorageType": "901",
    "StorageBin": "0000861200",
    "StorageLocation": "1711",
    "MovementType": "712",
    "Quantity": 25,
    "Unit": "M",
    "Reference": "stocktake corr."
    //"TestRun": true
}
###


### GET /api/warehouse/open-transfer-requirements  (LT04 tile — lists open TRs
### ready to be confirmed. Optional mrpController filter.)
GET {{baseUrl}}/api/warehouse/open-transfer-requirements
Content-Type: application/json
Authorization: Bearer {{token}}
###


### POST /api/warehouse/create-lt04  (replicates transaction LT04 exactly as
### recorded in wm_lt01.xltm's create_LT04 — see WarehouseHelpers.
### BuildCreateLt04Request. Swap in a real open TR number + material/batch
### combination from open-transfer-requirements above before running for
### real; a quality-blocked batch (LQUA BESTQ='Q') will fail fast with a 422
### instead of ever reaching SAP's LT04.)
POST {{baseUrl}}/api/warehouse/create-lt04
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "TrNumber": "0000123456",
    "Material": "B6040/S",
    "Quantity": 25,
    "DestinationType": "001",
    "DestinationBin": "A-01-01",
    "PalletOrBatch": "0035108565"
}
###
