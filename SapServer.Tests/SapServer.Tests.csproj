<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Replaces Microsoft.AspNetCore.Mvc.Testing (WebApplicationFactory<Program>,
         no equivalent on net48/OWIN) — Microsoft.Owin.Testing.TestServer drives the
         exact same in-memory OWIN pipeline via Startup.ConfigurePipeline. -->
    <PackageReference Include="Microsoft.Owin.Testing" Version="4.2.*" />
    <!-- HttpClient.PostAsJsonAsync/ReadFromJsonAsync are BCL members on
         net5.0+ only; this standalone package brings the same extension
         methods to net48. -->
    <PackageReference Include="System.Net.Http.Json" Version="9.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SapServer.csproj" />
  </ItemGroup>

</Project>
