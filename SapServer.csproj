<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SapServer</RootNamespace>
    <AssemblyName>SapServer</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!--
    SAP NCo — the only SAP transport now (SAPFunctions64 COM/STA pool was
    removed in the .NET Framework 4.8 + NCo rebuild; see CLAUDE.md). Real
    DLLs always win when present, same present-DLL-wins pattern used
    throughout this file: drop sapnco.dll/sapnco_utils.dll (downloaded from
    the SAP Support Portal under a licensed S-user) into libs\, and the
    matched native binary set (librfc32.dll/librfcum.dll, icudt*/icuin*/
    icuuc*.dll, matching VC++ runtime — never mix versions across NCo
    releases) into libs\sapnco-native\. Until then this falls back to
    interop-stubs\SapNco.DevStub, which only supplies enough of
    SAP.Middleware.Connector's shape to compile — see that project for the
    full rationale and its "not verified against the real assemblies" caveat.
  -->
  <ItemGroup Condition="Exists('libs\sapnco.dll') And Exists('libs\sapnco_utils.dll')">
      <Reference Include="sapnco">
        <HintPath>libs\sapnco.dll</HintPath>
        <Private>true</Private>
      </Reference>
      <Reference Include="sapnco_utils">
        <HintPath>libs\sapnco_utils.dll</HintPath>
        <Private>true</Private>
      </Reference>
  </ItemGroup>
  <ItemGroup Condition="!(Exists('libs\sapnco.dll') And Exists('libs\sapnco_utils.dll'))">
      <ProjectReference Include="interop-stubs\SapNco.DevStub\SapNco.DevStub.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\sapnco-native')">
    <None Include="libs\sapnco-native\*.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    web.config carries the OWIN startup wiring (owin:AppStartup) and the
    IIS module registration (OwinHttpModule) that makes IIS actually route
    requests into the app at all — without it in the published output,
    every request just hits IIS's own default StaticFileModule and 404s,
    confirmed for real: it was present on an early publish (likely copied
    incidentally, e.g. by a NuGet package's own build targets) but silently
    dropped by a later one. Unlike Microsoft.NET.Sdk.Web, plain
    Microsoft.NET.Sdk has no built-in "always publish web.config" handling,
    so it must be pinned explicitly — Update (not Include) because SDK-style
    default item globs already pick it up implicitly as a None item; adding
    it again via Include would be a duplicate-item error.
  -->
  <ItemGroup>
    <None Update="web.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    Same gap as web.config above, for appsettings.json/appsettings.{Env}.json:
    plain Microsoft.NET.Sdk doesn't copy None items to the publish output by
    default, and appsettings*.json (gitignored — see appsettings.example.json)
    matches the default None glob, not Content. Confirmed by a real local
    `dotnet publish` with dummy appsettings.json/appsettings.Production.json
    dropped in: neither showed up in the output. Startup.BuildConfiguration()
    reads appsettings.json with optional:false, so without this pin the app
    would throw a FileNotFoundException for it at startup — a site root
    (HostingEnvironment.MapPath("~/")) file, same as web.config, not a bin\
    one, so it's pinned here rather than swept up by the bin\ relocation
    target below.
  -->
  <ItemGroup>
    <None Update="appsettings.json;appsettings.*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    System.Web/IIS hosting only probes .\bin\ (plus the GAC) for private
    assemblies — baked into HostingEnvironment's AppDomain setup, not
    configurable via web.config. Microsoft.NET.Sdk (unlike
    Microsoft.NET.Sdk.Web) has no notion of that convention: `dotnet publish`
    lays out a flat, console-app-style folder with web.config and every DLL
    side by side in the publish root. Confirmed for real against a live IIS
    site: it threw FileNotFoundException loading Microsoft.Owin.Host.SystemWeb.dll
    even though the file was sitting right next to web.config, because
    ASP.NET's assembly probing never looks at the site root itself — only
    bin\. This target runs after Publish and relocates every managed/native
    binary (including the SAP NCo native DLLs copied in from libs\sapnco-native\
    above, which need to sit next to sapnco.dll/sapnco_utils.dll for NCo's own
    native-library loading to find them) into publish\bin\, leaving
    web.config/appsettings*.json at the site root where IIS and
    Startup.cs's HostingEnvironment.MapPath("~/") both expect them.
  -->
  <Target Name="RelocatePublishedBinariesToBin" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedBinariesToRelocate Include="$(PublishDir)*.dll" />
      <_PublishedBinariesToRelocate Include="$(PublishDir)*.pdb" />
      <_PublishedBinariesToRelocate Include="$(PublishDir)*.dll.config" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)bin" Condition="'@(_PublishedBinariesToRelocate)' != ''" />
    <Move SourceFiles="@(_PublishedBinariesToRelocate)" DestinationFolder="$(PublishDir)bin" Condition="'@(_PublishedBinariesToRelocate)' != ''" />
  </Target>

  <!-- .NET Framework GAC assemblies needed by System.Web.Http / OWIN-hosted-in-IIS.
       System.ComponentModel.DataAnnotations isn't implicitly referenced on a
       plain net48 Microsoft.NET.Sdk target the way it is under Microsoft.NET.Sdk.Web
       or netcoreapp — Models/RfcModels.cs and Models/Bapi/*.cs use
       [Required]/[StringLength]/[Range]/etc., so it must be listed explicitly. -->
  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web API 2 hosted in IIS via OWIN (Microsoft.Owin.Host.SystemWeb) — keeps the
         Startup.cs/OWIN-pipeline shape close to Program.cs's old minimal-hosting-model
         pipeline, instead of the classic Global.asax/System.Web.Http.WebHost route. -->
    <PackageReference Include="Microsoft.AspNet.WebApi.Owin" Version="5.3.*" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.*" />
    <PackageReference Include="Microsoft.Owin.Security.Jwt" Version="4.2.*" />
    <PackageReference Include="Microsoft.Owin.Cors" Version="4.2.*" />
    <!-- No direct System.IdentityModel.Tokens.Jwt/Microsoft.IdentityModel.Tokens
         reference — let Microsoft.Owin.Security.Jwt pull whatever version it
         was actually built against transitively, rather than risk a version
         mismatch against a much newer IdentityModel line pulled in directly. -->

    <!-- Microsoft.Extensions.* still target netstandard2.0, so the same DI/config/options/
         logging model from Program.cs carries over almost unchanged onto net48 — pinned to
         the 8.x LTS line rather than 10.x specifically to stay on a well-established
         netstandard2.0-compatible major version for a .NET Framework consumer. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.*" />

    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
    <PackageReference Include="Swashbuckle" Version="5.6.*" />
  </ItemGroup>

  <!--
    Both interop-stubs/ and SapServer.Tests/ are separate SDK projects nested
    under this project's own directory — without excluding their own
    Compile/Content/None items, this project would treat SapServer.Tests's
    own bin/obj output as its own content to copy on every build (it's
    nested inside this directory), recursively nesting it deeper each time.
  -->
  <!--
    publish/ is where scripts/deploy.ps1 (and a plain `dotnet publish`) write
    output — including a refs/ subfolder of reference assemblies for a
    framework-dependent publish. It's gitignored, not deleted, so a
    previously-built publish/ directory (in particular one left over from
    this app's earlier ASP.NET Core/net10.0 lifetime) sits on disk across
    the SDK/TargetFramework switch. Microsoft.NET.Sdk's default item globs
    auto-exclude bin/ and obj/ but NOT publish/, so without this exclusion a
    stale publish/ tree gets swept into this project's own item groups.
  -->
  <ItemGroup>
    <Compile Remove="interop-stubs\**\*.cs" />
    <Compile Remove="SapServer.Tests\**\*.cs" />
    <Compile Remove="publish\**\*.cs" />
    <Content Remove="interop-stubs\**" />
    <Content Remove="SapServer.Tests\**" />
    <Content Remove="publish\**" />
    <None Remove="interop-stubs\**" />
    <None Remove="SapServer.Tests\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <!-- Lets SapServer.Tests unit-test the internal Helpers/* request builders
       and response parsers directly, without making them public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SapServer.Tests" />
  </ItemGroup>
</Project>
